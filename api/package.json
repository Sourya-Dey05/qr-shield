{
  "name": "qr-shield-api",
  "version": "1.0.0",
  "description": "QR-Shield backend API — Phase 1",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "typecheck:tools": "tsc -p tsconfig.tools.json",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"tools/**/*.ts\"",
    "check": "npm run typecheck && npm run typecheck:tools && npm run lint && npm test",
    "test": "jest --runInBand --forceExit",
    "stub": "tsx tools/stub-merchant-server.ts",
    "demo": "tsx tools/demo.ts"
  },
  "dependencies": {
    "express": "^4.18.2",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.2",
    "tsx": "^4.7.3",
    "typescript": "^5.4.5"
  }
}
