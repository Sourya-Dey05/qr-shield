# ─── QR-Shield: local demo configuration ──────────────────────────────────────
#
# Copy to .env to run the backend against the LOCAL STUB merchant provider:
#
#   cp .env.stub.example .env
#
# Then, in three terminals:
#
#   npm run stub     ← fake merchant verification provider (port 4010)
#   npm run dev      ← QR-Shield API (port 3001)
#   npm run demo     ← drives every scenario and prints the badges
#
# ⚠️  THE STUB IS NOT VERIFICATION.
# Every merchant it returns is a fixture defined in
# tools/stub-merchant-server.ts. A Green or Amber badge produced against it
# is NOT a statement about a real merchant. This configuration is for
# development and demos only.
#
# When real vendor credentials arrive, delete MERCHANT_API_URL and
# NPCI_API_KEY below, fill in the real values, and remove the dot-path
# overrides if the real vendor returns a flat body.

PORT=3001

# ─── Merchant service ────────────────────────────────────────────────────────
MERCHANT_API_URL=http://127.0.0.1:4010/lookup
NPCI_API_KEY=stub-dev-key

# The stub requires a bearer token in this header.
MERCHANT_AUTH_HEADER=Authorization
MERCHANT_AUTH_SCHEME=Bearer
MERCHANT_UPI_PARAM=upiId

# The stub returns a NESTED body on purpose, so these dot paths are genuinely
# exercised rather than bypassed:
#
#   { "data": { "isVerified": true, "merchant": { "displayName": "..." } } }
#
# If a real vendor returns a flat { "verified": true, "name": "..." },
# change these back to: verified / name
MERCHANT_VERIFIED_PATH=data.isVerified
MERCHANT_NAME_PATH=data.merchant.displayName

# Keep this short so the stub-slow@upi demo fails fast.
MERCHANT_TIMEOUT_MS=3000
MERCHANT_CACHE_TTL_MS=300000

# ─── Fraud / ML service ──────────────────────────────────────────────────────
# Blank: uses the deterministic mock fraud provider.
ML_SERVICE_URL=
ML_SERVICE_API_KEY=