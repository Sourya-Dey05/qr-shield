# Backend environment variables
# Copy this file to .env and fill in values for local development.
# Never commit .env — it is in .gitignore.

# Port the dev server listens on (optional, defaults to 3001)
PORT=3001

# ─── Merchant service (Phase 2) ───────────────────────────────────────────────
#
# Leave MERCHANT_API_URL blank to use the built-in mock provider (Phase 1
# fixture data — it is NOT real verification).
#
# Set it to switch to the real HTTP provider. The provider is vendor-agnostic:
# endpoint, auth header and response field names are all configurable, so
# changing vendor is a configuration change, not a code change.

# Base URL of the merchant verification endpoint.
# The UPI ID is appended as a query parameter to this URL.
MERCHANT_API_URL=
#   Example: MERCHANT_API_URL=https://api.vendor.com/v1/merchants

# Credential sent to the provider. Required when MERCHANT_API_URL is set —
# without it the API fails closed with 503 rather than guessing.
NPCI_API_KEY=

# Header the credential is sent in (default: Authorization)
MERCHANT_AUTH_HEADER=Authorization

# Prefix before the credential. "Bearer" sends `Bearer <key>`.
# Leave blank to send the raw key.
MERCHANT_AUTH_SCHEME=Bearer

# Query parameter used to send the UPI ID (default: upiId)
MERCHANT_UPI_PARAM=upiId

# Dot-path to the boolean verification flag in the provider response.
# Example for a nested body {"data":{"isVerified":true}}: MERCHANT_VERIFIED_PATH=data.isVerified
MERCHANT_VERIFIED_PATH=verified

# Dot-path to the merchant name in the provider response (default: name)
MERCHANT_NAME_PATH=name

# Request timeout in milliseconds (default: 5000).
# On timeout the API returns 503 MERCHANT_SERVICE_ERROR.
MERCHANT_TIMEOUT_MS=5000

# How long a successful lookup is cached, in ms (default: 300000 = 5 minutes).
# Set to 0 to disable caching and call the provider on every request.
MERCHANT_CACHE_TTL_MS=300000

# ─── Fraud / ML service (Phase 3) ──────────────────────────────────────────────
# When a real ML service is deployed, set these two variables.
# Leave blank to use the mock fraud provider.
ML_SERVICE_URL=
ML_SERVICE_API_KEY=

# ─── Future variables (Phase 4) ────────────────────────────────────────────────
# FRAUD_API_KEY=      (if a third-party fraud API is used instead of the internal ML service)